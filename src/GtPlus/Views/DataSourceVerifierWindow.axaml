<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GtPlus.Views.DataSourceVerifierWindow"
        Title="Data Source Verifier"
        Width="1020" Height="660"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a">

    <DockPanel Margin="12">

        <!-- source bar: URL, format, GET -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto,Auto,Auto"
              Margin="0,0,0,8">

            <TextBox x:Name="UrlBox"
                     Grid.Column="0"
                     Watermark="http://server/scores.json"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />

            <ComboBox x:Name="FormatCombo"
                      Grid.Column="1"
                      Width="150"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      SelectionChanged="FormatCombo_SelectionChanged">
                <ComboBoxItem Content="JSON" />
                <ComboBoxItem Content="XML" />
                <ComboBoxItem Content="Excel File/CSV" />
            </ComboBox>

            <Button x:Name="GetButton"
                    Grid.Column="2"
                    Content="GET"
                    Padding="18,5"
                    Margin="0,0,8,0"
                    Click="Get_Click" />

            <Button x:Name="FileButton"
                    Grid.Column="3"
                    Content="File..."
                    Padding="14,5"
                    ToolTip.Tip="Load a local .json, .xml, .csv or .xlsx file"
                    Click="File_Click" />
        </Grid>

        <!-- options bar -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="Auto,Auto,*,Auto"
              Margin="0,0,0,8">

            <CheckBox x:Name="HeaderCheck"
                      Grid.Column="0"
                      Content="First row is column names"
                      IsChecked="True"
                      Foreground="#cccccc"
                      FontSize="12"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"
                      IsCheckedChanged="HeaderCheck_IsCheckedChanged" />

            <StackPanel Grid.Column="1"
                        x:Name="RecordPanel"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <TextBlock Text="Row"
                           Foreground="#cccccc"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="RecordCombo"
                          MinWidth="200"
                          VerticalAlignment="Center"
                          SelectionChanged="RecordCombo_SelectionChanged" />
            </StackPanel>

            <TextBlock x:Name="FetchStatus"
                       Grid.Column="3"
                       Text=""
                       Foreground="#888888"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- footer -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto"
              Margin="0,10,0,0">

            <TextBlock x:Name="SummaryText"
                       Grid.Column="0"
                       Text=""
                       Foreground="#888888"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0" />

            <Button Grid.Column="1"
                    Content="Close"
                    Padding="18,6"
                    Click="Close_Click" />
        </Grid>

        <!-- data (left) and element matches (right) -->
        <Grid ColumnDefinitions="*,8,*">

            <Border Grid.Column="0"
                    Background="#141414"
                    BorderBrush="#333333"
                    BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#1e1e1e"
                            BorderBrush="#333333"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="DATA"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#888888"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DataHint"
                                       Grid.Column="2"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#666666"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBox x:Name="DataBox"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas,Courier New,monospace"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Watermark="Paste or edit the data here"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="DataBox_TextChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#141414"
                    BorderBrush="#333333"
                    BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#1e1e1e"
                            BorderBrush="#333333"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="ELEMENTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#888888"
                                       VerticalAlignment="Center" />
                            <ToggleButton x:Name="SortButton"
                                          Grid.Column="2"
                                          Content="Sort by problem"
                                          FontSize="11"
                                          Padding="8,1"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="Worst first: unusable, missing, case mismatch, not verified, hidden, then matched"
                                          Click="SortButton_Click" />
                            <TextBlock x:Name="ElementsHint"
                                       Grid.Column="3"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#666666"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResultStack" Spacing="0" Margin="0,2" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
