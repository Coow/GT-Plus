<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GtPlus.Views.AboutWindow"
        Title="About"
        Width="340" Height="300"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a">

    <DockPanel Margin="20">

        <TextBlock DockPanel.Dock="Bottom"
                   x:Name="VersionText"
                   Text="Version: "
                   FontSize="11"
                   Foreground="#888888"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0" />

        <StackPanel Spacing="14">

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Ellipse Width="64" Height="64">
                    <Ellipse.Fill>
                        <ImageBrush Source="avares://GtPlus/Assets/Misc/cow.gif"
                                    Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="Made by AnMagicalCow"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#eeeeee"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Height="1" Background="#333333" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Source="avares://GtPlus/Assets/Misc/Discord.png"
                       Width="22" Height="22"
                       VerticalAlignment="Center" />
                <TextBlock Text="@AnMagicalCow"
                           FontSize="12"
                           Foreground="#cccccc"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Source="avares://GtPlus/Assets/Misc/Github.png"
                       Width="22" Height="22"
                       VerticalAlignment="Center" />
                <Button x:Name="GithubButton"
                        Classes="link"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Click="Github_Click">
                    <TextBlock Text="https://github.com/Coow/gt-plus"
                               FontSize="12"
                               Foreground="#6ea8fe"
                               TextDecorations="Underline" />
                </Button>
            </StackPanel>

        </StackPanel>
    </DockPanel>
</Window>
