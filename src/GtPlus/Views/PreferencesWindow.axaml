<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GtPlus.Views.PreferencesWindow"
        Title="Preferences"
        Width="400" Height="520"
        MinWidth="340" MinHeight="240"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a">

    <!-- title and Close stay put, the settings themselves scroll so a short window still reaches every section -->
    <DockPanel Margin="20">

        <TextBlock DockPanel.Dock="Top"
                   Text="Preferences"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#eeeeee"
                   Margin="0,0,0,14" />

        <Button DockPanel.Dock="Bottom"
                Content="Close"
                HorizontalAlignment="Right"
                Padding="18,6"
                Margin="0,14,0,0"
                Click="Close_Click" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="0,0,10,0">

        <Border Height="1" Background="#333333" />

        <!-- canvas section -->
        <StackPanel Spacing="8">
            <TextBlock Text="CANVAS"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#888888" />

            <StackPanel Spacing="4">
                <TextBlock Text="Outside Canvas Transparency"
                           Foreground="#cccccc"
                           FontSize="12" />

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0"
                               Text="0%"
                               Foreground="#666666"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <Slider x:Name="TransparencySlider"
                            Grid.Column="1"
                            Minimum="0" Maximum="100" Value="70"
                            VerticalAlignment="Center"
                            ValueChanged="TransparencySlider_ValueChanged" />

                    <TextBlock Grid.Column="2"
                               Text="100%"
                               Foreground="#666666"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0,10,0" />

                    <TextBlock x:Name="TransparencyLabel"
                               Grid.Column="3"
                               Text="70%"
                               Width="38"
                               Foreground="#cccccc"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Outside Layer Transparency"
                           Foreground="#cccccc"
                           FontSize="12" />

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0"
                               Text="0%"
                               Foreground="#666666"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <Slider x:Name="LayerTransparencySlider"
                            Grid.Column="1"
                            Minimum="0" Maximum="100" Value="70"
                            VerticalAlignment="Center"
                            ValueChanged="LayerTransparencySlider_ValueChanged" />

                    <TextBlock Grid.Column="2"
                               Text="100%"
                               Foreground="#666666"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0,10,0" />

                    <TextBlock x:Name="LayerTransparencyLabel"
                               Grid.Column="3"
                               Text="70%"
                               Width="38"
                               Foreground="#cccccc"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>

                <TextBlock Text="A layer frame masks its contents, so overflow never renders. The selected layer shows its overflow at this transparency instead, so it can still be seen and dragged."
                           Foreground="#777777"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <CheckBox x:Name="AutoFitTimelineCheck"
                          Content="Auto-fit When Timeline Opens"
                          Foreground="#cccccc"
                          FontSize="12"
                          IsCheckedChanged="AutoFitTimelineCheck_IsCheckedChanged" />

                <TextBlock Text="Opening the timeline shortens the canvas view. When this is on, the zoom drops to Fit if the canvas no longer fits without scrollbars."
                           Foreground="#777777"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Shift+Arrow Nudge Distance"
                           Foreground="#cccccc"
                           FontSize="12" />

                <NumericUpDown x:Name="NudgeStepBox"
                               Minimum="1" Maximum="1000" Increment="1"
                               FormatString="0"
                               Value="10"
                               Width="120"
                               HorizontalAlignment="Left"
                               ValueChanged="NudgeStepBox_ValueChanged" />

                <TextBlock Text="With the Edit tool, arrow keys move the selection by 1px. Holding Shift moves it by this many pixels instead."
                           Foreground="#777777"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border Height="1" Background="#333333" />

        <!-- canvas background section -->
        <StackPanel Spacing="8">
            <TextBlock Text="CANVAS BACKGROUND"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#888888" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton x:Name="SolidBackgroundRadio"
                             GroupName="CanvasBackground"
                             Content="Solid Color"
                             Foreground="#cccccc"
                             FontSize="12"
                             IsCheckedChanged="BackgroundMode_IsCheckedChanged" />
                <RadioButton x:Name="GridBackgroundRadio"
                             GroupName="CanvasBackground"
                             Content="Grid Pattern"
                             Foreground="#cccccc"
                             FontSize="12"
                             IsCheckedChanged="BackgroundMode_IsCheckedChanged" />
            </StackPanel>

            <!-- solid colour -->
            <StackPanel x:Name="SolidBackgroundPanel" Spacing="4">
                <TextBlock Text="Background Color"
                           Foreground="#cccccc"
                           FontSize="12" />

                <Button x:Name="SolidColorButton"
                        Width="52" Height="26" Padding="2"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="Canvas Background Color"
                        Click="SolidColorButton_Click">
                    <Panel>
                        <Border CornerRadius="2" Background="#888888" />
                        <Border x:Name="SolidColorSwatch" CornerRadius="2" />
                    </Panel>
                </Button>
            </StackPanel>

            <!-- grid colours + cell size -->
            <StackPanel x:Name="GridBackgroundPanel" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Primary"
                                   Foreground="#cccccc"
                                   FontSize="12" />
                        <Button x:Name="GridColorButton"
                                Width="52" Height="26" Padding="2"
                                ToolTip.Tip="Grid Primary Color"
                                Click="GridColorButton_Click">
                            <Panel>
                                <Border CornerRadius="2" Background="#888888" />
                                <Border x:Name="GridColorSwatch" CornerRadius="2" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Secondary"
                                   Foreground="#cccccc"
                                   FontSize="12" />
                        <Button x:Name="GridSecondaryColorButton"
                                Width="52" Height="26" Padding="2"
                                ToolTip.Tip="Grid Secondary Color"
                                Click="GridSecondaryColorButton_Click">
                            <Panel>
                                <Border CornerRadius="2" Background="#888888" />
                                <Border x:Name="GridSecondaryColorSwatch" CornerRadius="2" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Square Size"
                                   Foreground="#cccccc"
                                   FontSize="12" />
                        <NumericUpDown x:Name="GridSizeBox"
                                       Minimum="2" Maximum="512" Increment="2"
                                       FormatString="0"
                                       Value="32"
                                       Width="110"
                                       ValueChanged="GridSizeBox_ValueChanged" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="One square, in document pixels, so the pattern scales with the zoom level."
                           Foreground="#777777"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="The background sits behind the document on the editing canvas only. It is never composited into an exported video."
                       Foreground="#777777"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Height="1" Background="#333333" />

        <!-- guides and snapping section -->
        <StackPanel Spacing="8">
            <TextBlock Text="GUIDES &amp; SNAPPING"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#888888" />

            <StackPanel Spacing="4">
                <TextBlock Text="Snap Distance"
                           Foreground="#cccccc"
                           FontSize="12" />

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto">
                    <TextBlock Grid.Column="0"
                               Text="1px"
                               Foreground="#666666"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <Slider x:Name="SnapDistanceSlider"
                            Grid.Column="1"
                            Minimum="1" Maximum="40" Value="8"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="SnapDistanceSlider_ValueChanged" />

                    <TextBlock Grid.Column="2"
                               Text="40px"
                               Foreground="#666666"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="6,0,10,0" />

                    <TextBlock x:Name="SnapDistanceLabel"
                               Grid.Column="3"
                               Text="8px"
                               Width="38"
                               Foreground="#cccccc"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>

                <TextBlock Text="How close a dragged edge must come before it snaps to a guide, element or canvas line."
                           Foreground="#777777"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border Height="1" Background="#333333" />

        <!-- updates section -->
        <StackPanel Spacing="8">
            <TextBlock Text="UPDATES"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#888888" />

            <StackPanel Spacing="4">
                <CheckBox x:Name="StartupUpdateCheck"
                          Content="Check for Updates on Startup"
                          Foreground="#cccccc"
                          FontSize="12"
                          IsCheckedChanged="StartupUpdateCheck_IsCheckedChanged" />

                <TextBlock Text="Asks GitHub whether a newer release exists and says so only when there is one. Updates are never downloaded or installed automatically."
                           Foreground="#777777"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="CheckUpdatesButton"
                    Content="Check for Updates Now"
                    Padding="12,5"
                    HorizontalAlignment="Left"
                    Click="CheckUpdates_Click" />
        </StackPanel>

        <Border Height="1" Background="#333333" />

        <!-- developer section -->
        <StackPanel Spacing="8">
            <TextBlock Text="DEVELOPER"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#888888" />

            <CheckBox x:Name="DebugPanelCheck"
                      Content="Show Debug Info Panel"
                      Foreground="#cccccc"
                      FontSize="12"
                      IsCheckedChanged="DebugPanelCheck_IsCheckedChanged" />
        </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
