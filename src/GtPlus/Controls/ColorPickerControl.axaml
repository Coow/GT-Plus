<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GtPlus.Controls.ColorPickerControl"
             Width="300"
             Focusable="True"
             FocusAdorner="{x:Null}">

    <UserControl.Styles>
        <!-- transparent background not none, stretched not centred: the label is a drag-to-scrub target and has to be hit-testable across its whole cell -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.field">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Border.field:focus-within">
            <Setter Property="BorderBrush" Value="#6a6a6a"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.field:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button#GradientButton">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="Button#GradientButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3a3a"/>
            <Setter Property="BorderBrush" Value="#6a6a6a"/>
        </Style>
        <Style Selector="Button#GradientButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#6a6a6a"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#1c1c1c"
            BorderBrush="#484848"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8">
        <StackPanel Spacing="6">

            <!-- spectrum: SV plane at fixed hue -->
            <Panel x:Name="SpectrumPanel" Height="150" Cursor="Cross">
                <Border x:Name="SpectrumHueBg" CornerRadius="2"/>
                <Border CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas x:Name="SpectrumCanvas">
                    <Ellipse x:Name="SpectrumThumb"
                             Width="12" Height="12"
                             Stroke="White" StrokeThickness="2"
                             Fill="Transparent"
                             IsHitTestVisible="False"/>
                </Canvas>
            </Panel>

            <!-- hue bar -->
            <Panel x:Name="HuePanel" Height="14" Cursor="SizeWestEast">
                <Border CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#FFFF0000" Offset="0"/>
                            <GradientStop Color="#FFFFFF00" Offset="0.167"/>
                            <GradientStop Color="#FF00FF00" Offset="0.333"/>
                            <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                            <GradientStop Color="#FF0000FF" Offset="0.667"/>
                            <GradientStop Color="#FFFF00FF" Offset="0.833"/>
                            <GradientStop Color="#FFFF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas x:Name="HueCanvas">
                    <Border x:Name="HueThumb"
                            Width="4" Height="14"
                            Background="White"
                            BorderBrush="#666666" BorderThickness="1"
                            CornerRadius="1"
                            IsHitTestVisible="False"/>
                </Canvas>
            </Panel>

            <!-- alpha bar -->
            <Panel x:Name="AlphaPanel" Height="14" Cursor="SizeWestEast">
                <Border CornerRadius="2" Background="#888888"/>
                <Border x:Name="AlphaGradientBorder" CornerRadius="2"/>
                <Canvas x:Name="AlphaCanvas">
                    <Border x:Name="AlphaThumb"
                            Width="4" Height="14"
                            Background="White"
                            BorderBrush="#666666" BorderThickness="1"
                            CornerRadius="1"
                            IsHitTestVisible="False"/>
                </Canvas>
            </Panel>

            <!-- preview swatch + hex -->
            <Grid ColumnDefinitions="Auto,*"
                  ToolTip.Tip="Ctrl+C copies the colour as HEX, Ctrl+V pastes a HEX, rgb() or hsl() colour">

                <!-- checkerboard + colour preview swatch -->
                <Panel Grid.Column="0" Width="28" Height="28" Margin="0,0,6,0">
                    <Border CornerRadius="3" BorderBrush="#444444" BorderThickness="1"
                            Background="#888888"/>
                    <Border x:Name="PreviewBorder"
                            CornerRadius="3" BorderBrush="#444444" BorderThickness="1"/>
                </Panel>

                <!-- HEX entry: #RGB, #RRGGBB or #AARRGGBB, the # is optional -->
                <Border Grid.Column="1" Classes="field" VerticalAlignment="Center">
                    <TextBox x:Name="HexBox"
                             Classes="field"
                             Text="#FFFFFFFF"
                             FontSize="11"
                             FontFamily="Consolas,Courier New,monospace"
                             HorizontalContentAlignment="Left"/>
                </Border>

            </Grid>

            <!-- RGBA entry -->
            <Grid ColumnDefinitions="14,*,3,14,*,3,14,*,3,14,*">
                <TextBlock Grid.Column="0" x:Name="RLabel" Text="R" Classes="label"/>
                <Border Grid.Column="1" Classes="field">
                    <TextBox x:Name="RBox" Classes="field"/>
                </Border>

                <TextBlock Grid.Column="3" x:Name="GLabel" Text="G" Classes="label"/>
                <Border Grid.Column="4" Classes="field">
                    <TextBox x:Name="GBox" Classes="field"/>
                </Border>

                <TextBlock Grid.Column="6" x:Name="BLabel" Text="B" Classes="label"/>
                <Border Grid.Column="7" Classes="field">
                    <TextBox x:Name="BBox" Classes="field"/>
                </Border>

                <TextBlock Grid.Column="9" x:Name="ALabel" Text="A" Classes="label"/>
                <Border Grid.Column="10" Classes="field">
                    <TextBox x:Name="ABox" Classes="field"/>
                </Border>
            </Grid>

            <!-- HSL entry: hue in degrees, saturation and lightness in percent -->
            <Grid ColumnDefinitions="14,*,3,14,*,3,14,*,3,14,*">
                <TextBlock Grid.Column="0" x:Name="HLabel" Text="H" Classes="label"/>
                <Border Grid.Column="1" Classes="field" ToolTip.Tip="Hue, 0-360°">
                    <TextBox x:Name="HBox" Classes="field"/>
                </Border>

                <TextBlock Grid.Column="3" x:Name="SLabel" Text="S" Classes="label"/>
                <Border Grid.Column="4" Classes="field" ToolTip.Tip="HSL saturation, 0-100%">
                    <TextBox x:Name="SBox" Classes="field"/>
                </Border>

                <TextBlock Grid.Column="6" x:Name="LLabel" Text="L" Classes="label"/>
                <Border Grid.Column="7" Classes="field" ToolTip.Tip="Lightness, 0-100%">
                    <TextBox x:Name="LBox" Classes="field"/>
                </Border>
            </Grid>

            <!-- recent colors row -->
            <StackPanel x:Name="RecentPanel"
                        Orientation="Horizontal"
                        Spacing="3"/>

            <!-- switch to gradient fill -->
            <Button x:Name="GradientButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    ToolTip.Tip="Edit as a linear or radial gradient"
                    Click="GradientButton_Click">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- mini gradient preview chip -->
                    <Border Grid.Column="0"
                            Width="34" Height="14"
                            CornerRadius="2"
                            BorderBrush="#5a5a5a" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#FF3AA0FF" Offset="0"/>
                                <GradientStop Color="#FFB44DFF" Offset="0.5"/>
                                <GradientStop Color="#FFFF4D6D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="Gradient"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#e6e6e6"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="&#x203A;"
                               FontSize="13"
                               Foreground="#888888"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0"/>
                </Grid>
            </Button>

        </StackPanel>
    </Border>

</UserControl>
