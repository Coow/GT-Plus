<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VmixGtPlus.Views.ExportVideoWindow"
        Title="Export Video"
        Width="560" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#1a1a1a">

    <StackPanel Margin="18" Spacing="12">

        <TextBlock Text="Export storyboard to MP4"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#eeeeee" />

        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4"
                       Text="Storyboard" VerticalAlignment="Center"
                       FontSize="12" Foreground="#cccccc" />
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                      x:Name="StoryboardCombo"
                      HorizontalAlignment="Stretch"
                      FontSize="12"
                      SelectionChanged="Storyboard_Changed" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4"
                       x:Name="HoldLabel"
                       Text="Hold" VerticalAlignment="Center"
                       FontSize="12" Foreground="#cccccc" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4" Orientation="Horizontal" Spacing="8">
                <NumericUpDown x:Name="HoldBox"
                               Width="120"
                               Minimum="0" Maximum="3600"
                               Increment="0.5"
                               FormatString="0.##"
                               FontSize="12"
                               ValueChanged="Hold_Changed" />
                <TextBlock x:Name="HoldHint"
                           VerticalAlignment="Center"
                           FontSize="11" Foreground="#777777" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4"
                       Text="Frame rate" VerticalAlignment="Center"
                       FontSize="12" Foreground="#cccccc" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="FpsCombo" Width="120" FontSize="12"
                          SelectionChanged="Fps_Changed" />
                <TextBlock x:Name="SummaryText"
                           VerticalAlignment="Center"
                           FontSize="11" Foreground="#777777" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4"
                       Text="Quality" VerticalAlignment="Center"
                       FontSize="12" Foreground="#cccccc" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="QualityCombo" Width="120" FontSize="12" />
                <TextBlock Text="Background" VerticalAlignment="Center"
                           FontSize="12" Foreground="#cccccc" />
                <ComboBox x:Name="BackgroundCombo" Width="120" FontSize="12" />
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4"
                       Text="Save to" VerticalAlignment="Center"
                       FontSize="12" Foreground="#cccccc" />
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,4" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" x:Name="OutputBox" FontSize="12"
                         Watermark="Choose an output file..." />
                <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0"
                        Padding="12,5" Click="Browse_Click" />
            </Grid>

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4"
                       Text="ffmpeg" VerticalAlignment="Center"
                       FontSize="12" Foreground="#cccccc" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,4" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" x:Name="FfmpegText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11" Foreground="#777777" />
                <Button Grid.Column="1" x:Name="LocateButton" Content="Locate..."
                        Margin="8,0,0,0" Padding="10,4" FontSize="11"
                        Click="Locate_Click" />
                <Button Grid.Column="2" x:Name="DownloadButton" Content="Download"
                        Margin="6,0,0,0" Padding="10,4" FontSize="11"
                        Click="Download_Click" />
            </Grid>
        </Grid>

        <Border Height="1" Background="#333333" />

        <StackPanel Spacing="6">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" Height="6" />
            <TextBlock x:Name="StatusText"
                       FontSize="11" Foreground="#999999"
                       TextWrapping="Wrap"
                       Text="Ready." />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" x:Name="CloseButton" Content="Close"
                    Padding="12,5" Margin="0,0,8,0" Click="Close_Click" />
            <Button Grid.Column="2" x:Name="ExportButton" Content="Export"
                    Padding="20,5" IsDefault="True" Click="Export_Click" />
        </Grid>

    </StackPanel>
</Window>
